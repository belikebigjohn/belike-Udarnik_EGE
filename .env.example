# Never commit the real bot token.
BOT_TOKEN=
APP_URL=https://your-domain.example/
PORT=8080
DATABASE_PATH=./data/progress.sqlite3
REMINDER_HOUR_UTC=12
# Local browser preview only; Telegram polling is disabled in this mode:
DEV_MODE=0
# Optional target exam date. Leave empty until an approved date is configured.
EGE_DATE=
# Set 1 only for a date confirmed by the official schedule; otherwise "target date".
EGE_DATE_OFFICIAL=0
